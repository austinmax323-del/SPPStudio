# === SPPStudio .gitignore ===
# Created as part of an AI-setup hardening pass. See SETUP_REVIEW.md.

# --- Secrets (do NOT commit) ---
# Obsidian Local REST API bearer token lives here. Use .mcp.json.example as the
# committed template and keep the real token out of version control.
.mcp.json
# Obsidian Local REST API plugin stores the same apiKey in its data.json.
SPPStudioDocs/.obsidian/plugins/*/data.json
SPPStudioDocs/.obsidian/workspace*.json
SPPStudioDocs/.obsidian/graph*.json
SPPStudioDocs/.obsidian/app.json
SPPStudioDocs/.obsidian/appearance.json
SPPStudioDocs/.obsidian/backlink.json
SPPStudioDocs/.obsidian/types.json

# --- Local AI/tool state ---
.claude/
.codex/

# --- Build artifacts ---
.build/
.swiftpm/
dist/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.o
*.swiftmodule

# --- Regenerated session/runtime state (machine-local, churns constantly) ---
script/state/
~/Library/Caches/SPPStudio/
SPPStudioDocs/70_SessionContinuity/WorkerRuns/*.md

# --- Prompt-bridge ephemeral queues (keep templates, drop in-flight prompts) ---
SPPStudioDocs/40_PromptEngineering/PromptBridge/Queue/state/
SPPStudioDocs/40_PromptEngineering/PromptBridge/Outbox/pending.md
SPPStudioDocs/40_PromptEngineering/PromptBridge/Watchdog/

# --- OS / editor noise ---
.DS_Store
*.swp
*~
