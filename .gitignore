# === SPPStudio .gitignore ===

# --- Obsidian vault (private — never commit) ---
# The vault lives at /path/to/Obsidian/ and is symlinked here.
# Neither the symlink nor any vault content belongs in the public repo.
SPPStudioDocs
SPPStudioDocs/

# --- Secrets (do NOT commit) ---
.mcp.json

# --- Local AI/tool state ---
.claude/
.codex/

# --- spp-obsidian-plugin build output and dependencies ---
Tools/spp-obsidian-plugin/node_modules/
Tools/spp-obsidian-plugin/dist/

# --- Build artifacts ---
.build/
.swiftpm/
dist/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.o
*.swiftmodule

# --- Regenerated session/runtime state ---
script/state/

# --- OS / editor noise ---
.DS_Store
*.swp
*~
